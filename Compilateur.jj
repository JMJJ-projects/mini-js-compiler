PARSER_BEGIN(Compilateur)
import java.io.*;
import java.io.InputStream;
import java.util.List;
import java.util.ArrayList;
public class Compilateur {

    public static void main(String args[]) {
        try {
            if (args.length > 0) {
                String inputFileName = args[0];
                String outputFileName = inputFileName.substring(0, inputFileName.lastIndexOf('.')) + ".jsm";
                Compilateur parseur = new Compilateur(new FileInputStream(inputFileName));
                
                ExpressionA i = parseur.mainNT();
                
                BufferedWriter writer = new BufferedWriter(new FileWriter(outputFileName));
                writer.write(i.toAssembly());
                writer.write("\nHalt");
                writer.close();
                System.out.println("Output: " + outputFileName);
            } else {
                Compilateur parseur = new Compilateur(System.in);
				ExpressionA i = parseur.mainNT();
				System.out.println(i.toAssembly());
				System.out.println("Halt");
            }
        } catch (FileNotFoundException e) {
            System.out.println("Input erreur");
        } catch (IOException e) {
            System.out.println("Erreur");
        } catch (TokenMgrError e) {
            System.err.println("Erreur lexicale : " + e.getMessage());
            System.exit(1);
        } catch (ParseException e) {
            System.err.println("Erreur de syntaxe : " + e.getMessage());
            System.exit(1);
        }
    }

}


PARSER_END(Compilateur)
SKIP :
{
    " " | "\t" | "\r" | "\n"
|<COMMENT: "//" (~["\n", "\r"])* ("\n" | "\r" | "\r\n")?>
|<COMMENTMULT: "/*" (~["*"] | (("*")+ ~["/"]))* ("*")+ "/" >
}
TOKEN :
	{ < NUMBER: ["1"-"9"] (["0"-"9"])* 
	 |"0"
	 |"0." (["0"-"9"])*
         | ["1"-"9"] (["0"-"9"])* "." (["0"-"9"])*
   	 | ["1"-"9"] (["0"-"9"])* "." (["0"-"9"])* "e" ("-"|"+")? (["0"-"9"])+ 
    	 | ["1"-"9"] (["0"-"9"])* "e" ("-"|"+")? (["0"-"9"])+>
	 | <NaN : "NaN">
	  |<TRUE: "True">
	  |<FALSE: "False">
	  |<EQ: "==">
	  |<LOEQ: "<=">
	  |<GREQ: ">=">
	  |<IMPORT: "import">
	  |<AND: "&&">
	  |<IF: "if">
	  |<ELSE: "else">
	  |<DO: "do" >
	  |<WHILE: "while" >
	  |<PRINT: "print" >
	  |<AFFECTATION: "=">
	  |<IDENT : (["a"-"z", "A"-"Z", "_"]) (["a"-"z", "A"-"Z", "0"-"9", "_"])*>
	}

	
ExpressionA mainNT () :
	{
		ExpressionA e, res;
		List<ExpressionA> exprs = new ArrayList<>();
	}
	{
		(e=command() { exprs.add(e); } )+ <EOF>
    		{ res = exprs.size() == 1 ? e : new Sequence(exprs); return res.simplifie(); }

	}
	
ExpressionA command () :
{
	ExpressionA e, thenCmd, elseCmd, body, cond;
	Token t;
}
{
	<IF> "(" e=logique() ")" thenCmd=block() <ELSE> elseCmd=block() { return new IfElse(e, thenCmd, elseCmd); }
    	|<DO> body=block() <WHILE> "(" cond=logique() ")" ";" { return new DoWhile(body, cond); }
	| LOOKAHEAD(2) t=<IDENT> <AFFECTATION> e=multi_affectation() ";" {return new SetVar(t.image, e);}
	| <PRINT> "(" e=multi_affectation() ")" ";" { return new Print(e); }
	| e=logique() ";" { return new Discard(e); }
	| ";" { return new Empty(); }
	|<IMPORT> t = <IDENT> {return new Import(t.image);}

}

ExpressionA block() :
{
    List<ExpressionA> exprs = new ArrayList<>();
    ExpressionA e;
}
{
    "{"  (e=command() { exprs.add(e); })* "}" { return exprs.isEmpty() ? new Sequence(new ArrayList<>()) : exprs.size() == 1 ? exprs.get(0) : new Sequence(exprs); }
  | (e=command()) { exprs.add(e); } { return e; }
}

ExpressionA multi_affectation() :
{
	ExpressionA e;
}
{
	e=affectation() {return e;}
}
ExpressionA affectation() :
{
    ExpressionA e;
    Token t;
}
{
    LOOKAHEAD(2) t=<IDENT> <AFFECTATION> e=multi_affectation() {return new SetVar(t.image, e);}
    |e=logique() {return e;}
}


ExpressionA logique() :
{
    ExpressionA res, e;
}
{
    e=egalite() { res = e; }
    (
        "&&" e=egalite() { res = new And(res, e); }
    )*
    { return res; }
}
	
ExpressionA egalite () :
	{
	  	ExpressionA res;
		ExpressionA e;
	}
	{
	  	e = comparaison() { res = e; }
		(
		 "==" (e=comparaison()) {res = new Equal(res, e);}
		
		)*
		{return res;}
	}
	
ExpressionA comparaison () :
	{
	  	ExpressionA res;
		ExpressionA e;
	}
	{
	  	e = expression() { res = e; }
		(
		 "<=" (e=expression()) {res = new LoEq(res, e);}
		| ">=" (e=expression()) {res = new GrEq(res, e);}
		|"<" (e=expression()) {res = new LoSt(res, e);}
		| ">" (e=expression()) {res = new GrSt(res, e);}
		
		)*
		{return res;}
	}

ExpressionA expression () :
	{
	  	ExpressionA res;
		ExpressionA e;
	}
	{
	  	e = terme() { res = e; }
		( "+" (e=terme()) {res = new Plus (res, e);}
		| "-" (e=terme()) {res = new Moins(res, e);}
		)*
		{return res;}
	}

ExpressionA terme () :
	{
		ExpressionA res;
		ExpressionA e;
	}
	{
		e=facteur() {res = e;}
		( "*" (e=facteur()) {res = new Mult(res, e);}
		| "/" (e=facteur()) {res = new Divi(res, e);} 
		)* {return res;}
	}

ExpressionA facteur () :
	{
		ExpressionA e;
		Token t;
	}
	{
		"(" (e=multi_affectation()) ")" {return e;}
		| "-" (e=facteur()) {return new Neg(e);}
		| "!" (e=facteur()) {return new Not(e);}
		| t = <TRUE> {return new Bool("True");}
		| t = <FALSE> {return new Bool("False");}
		| t=<NUMBER> {	if (t.image.contains("e")) {
				String[] parts = t.image.split("e");
				double base = Double.parseDouble(parts[0]);
				int exponent = Integer.parseInt(parts[1]);
				return new Num (base * Math.pow(10, exponent));
			} else {
				if(t.image.contains(".")) {
				return new Num(Double.parseDouble(t.image));
				}
				else {return new Num(Double.parseDouble(t.image));}
			}}
		|t=<NaN> {return new Num("NaN");}
		|t=<IDENT> {return new Identifiant(t.image);}

	}

